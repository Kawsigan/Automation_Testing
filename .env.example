# ==============================================================================
# Keepwisely CMMS Automation - Environment Configuration Template
# Copy this file to '.env' and populate your local test environment variables.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Application URL
BASE_URL=https://app.keepwisely.com

# Browser Settings (chrome, firefox, edge)
BROWSER=chrome
HEADLESS=false

# Wait Timeouts (in seconds)
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=30

# Test Account Credentials (Use dedicated staging / QA credentials)
ADMIN_USERNAME=test_admin@keepwisely.com
ADMIN_PASSWORD=SampleTestPassword123!
